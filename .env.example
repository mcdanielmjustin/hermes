# Hermes Pipeline Configuration
# Copy this file to .env and fill in your values

# API Provider (nous or anthropic)
API_PROVIDER=nous

# For Nous/Qwen (recommended)
NOUS_API_KEY=your-nous-api-key-here
API_BASE_URL=https://inference-api.nousresearch.com/v1
DEFAULT_MODEL=qwen/qwen3.5-plus-02-15

# For Anthropic (optional)
# API_PROVIDER=anthropic
# ANTHROPIC_API_KEY=your-anthropic-key-here

# OneDrive path (optional, for distribution outputs)
# ONEDRIVE_DISTRIBUTION_DIR=/mnt/c/Users/mcdan/OneDrive - PassEPPP/Master CSVs
